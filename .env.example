# Добавьте эти переменные в Vercel → Settings → Environment Variables (Production).
# Секреты не называйте с префиксом VITE_ и не коммитьте .env в git.
TELEGRAM_BOT_TOKEN=
# Любая случайная строка из латиницы, цифр, _ и - (защита адреса бота). Сгенерировать: node -e "console.log(crypto.randomUUID())"
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_ID=-1003772984999
ADMIN_ID=6713072327
# Пригласительная ссылка с заявками на вступление, вида https://t.me/+AbCdEf
CHANNEL_INVITE_LINK=
CONTACT=@KristinaPerez9
BOT_USERNAME=SantaHalloween2026bot
DEADLINE=2026-11-08T23:59:00+01:00
MIN_SUBS=5
PRICE_STARS=499
# Защита ежедневной проверки постов (Vercel Cron)
CRON_SECRET=
# Redis (Upstash) Vercel добавит сам при подключении: KV_REST_API_URL, KV_REST_API_TOKEN
# Только для локального запуска npm run telegram:webhook: адрес сайта после деплоя, вида https://имя.vercel.app
SITE_URL=
# --- Лорд Морок (все три необязательны) ---
# Токен отдельного бота Морока из @BotFather. Без него Морок говорит через праздничного бота.
MOROK_BOT_TOKEN=
# id тестового канала для /morok_test, вида -100...
TEST_CHAT_ID=
# 1 — если в канале включены подписи авторов («Подписывать сообщения»)
CHANNEL_SIGNATURES=
